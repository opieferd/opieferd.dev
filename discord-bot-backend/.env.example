# Bot token from Discord Developer Portal -> Bot
DISCORD_TOKEN=

# Application ID from Discord Developer Portal -> General Information
DISCORD_CLIENT_ID=

# Optional: use a test server for instant command updates during development.
# Leave blank to register commands globally.
DISCORD_GUILD_ID=

# Optional health-check server port (hosting platforms often provide PORT).
PORT=3000

# Public URL linked by the /watch command.
WATCH_URL=https://opieferd.dev/watch/
